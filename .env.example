# Copiá este archivo como .env y ajustá los valores
# (docker compose lo lee automáticamente)

# --- auth-service ---
AUTH_PORT=3001
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5433
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth_password
AUTH_DB_NAME=auth_db

# --- OPCIONAL: usar Supabase en vez del Postgres de Docker ---
# Descomentá estas líneas y copiá los valores desde el botón "Connect" de tu proyecto
# (usá el "Session pooler" si tu red no tiene IPv6). Con Supabase corré solo `npm run dev:auth`,
# no `npm run infra:up`. Antes, ejecutá en el SQL Editor de Supabase:
#   CREATE SCHEMA IF NOT EXISTS auth_service;
# AUTH_DB_HOST=<host que te muestra Supabase>
# AUTH_DB_PORT=5432
# AUTH_DB_USER=postgres.<project-ref>
# AUTH_DB_PASSWORD=<la contraseña de la base que definiste al crear el proyecto>
# AUTH_DB_NAME=postgres
# AUTH_DB_SSL=true
# AUTH_DB_SCHEMA=auth_service   # NO uses "auth": es un schema reservado de Supabase

# --- restaurants-service ---
RESTAURANTS_PORT=3002
RESTAURANTS_MONGO_HOST=localhost
RESTAURANTS_MONGO_PORT=27018
RESTAURANTS_MONGO_USER=restaurants
RESTAURANTS_MONGO_PASSWORD=restaurants_password
RESTAURANTS_MONGO_DB=restaurants_db

# --- reservations-service ---
RESERVATIONS_PORT=3003
RESERVATIONS_DB_HOST=localhost
RESERVATIONS_DB_PORT=5434
RESERVATIONS_DB_USER=reservations
RESERVATIONS_DB_PASSWORD=reservations_password
RESERVATIONS_DB_NAME=reservations_db
# A qué dirección llama para consultar mesas y horarios (en Docker se pisa con el nombre del contenedor)
RESTAURANTS_SERVICE_URL=http://localhost:3002
# Los horarios de los restaurantes ("20:00") se interpretan en esta zona horaria
RESTAURANT_TIME_ZONE=America/Argentina/Buenos_Aires
# Duración de cada reserva, en minutos
RESERVATION_DURATION_MINUTES=90

# Seña (Fase 6). DEPOSIT_PER_PERSON_CENTS en centavos: 200000 = $2.000 por persona. Con 0 no se cobra seña.
DEPOSIT_PER_PERSON_CENTS=200000
DEPOSIT_CURRENCY=ARS
# Minutos que se retiene la mesa esperando el pago; pasado ese tiempo la reserva vence y la mesa se libera
PAYMENT_WINDOW_MINUTES=15
# Si el cliente cancela con menos de estas horas de anticipación, pierde la seña (si cancela el restaurante, se devuelve siempre)
REFUND_CUTOFF_HOURS=24

# --- payments-service ---
PAYMENTS_PORT=3004
PAYMENTS_DB_HOST=localhost
PAYMENTS_DB_PORT=5435
PAYMENTS_DB_USER=payments
PAYMENTS_DB_PASSWORD=payments_password
PAYMENTS_DB_NAME=payments_db
# Pasarela de pagos. Hoy solo 'simulated' (tokens de prueba: tok_approved, tok_declined, tok_slow...).
PAYMENT_PROVIDER=simulated
# La simulada aprueba cualquier pago de prueba. Con NODE_ENV=production (las imágenes de Docker) payments NO arranca
# con ella salvo que pongas esto en true. Dejalo así para desarrollo y e2e; en un deploy real, usá una pasarela real.
ALLOW_SIMULATED_GATEWAY=true
# Secreto con el que la pasarela firma los webhooks (HMAC). Generá uno propio: openssl rand -hex 32
GATEWAY_WEBHOOK_SECRET=cambiame-secreto-de-webhooks
# La pasarela simulada avisa el resultado de los pagos "lentos" (tok_slow) por webhook pasados estos milisegundos
SIMULATED_WEBHOOK_DELAY_MS=3000
# (en dev:payments el webhook vuelve a http://localhost:3004; se puede cambiar con SIMULATED_WEBHOOK_URL)

# --- notifications-service (bandeja de notificaciones del cliente; escucha los eventos de reservations-service) ---
NOTIFICATIONS_PORT=3005
NOTIFICATIONS_MONGO_HOST=localhost
NOTIFICATIONS_MONGO_PORT=27019
NOTIFICATIONS_MONGO_USER=notifications
NOTIFICATIONS_MONGO_PASSWORD=notifications_password
NOTIFICATIONS_MONGO_DB=notifications_db

# --- RabbitMQ (mensajería entre reservations-service y payments-service) ---
RABBITMQ_USER=reservas
RABBITMQ_PASSWORD=reservas_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# Dirección que usan los servicios que corrés FUERA de Docker (dev:*). Sin esta variable la mensajería queda
# deshabilitada: el servicio arranca igual y los eventos esperan en el outbox hasta que haya broker.
RABBITMQ_URL=amqp://reservas:reservas_password@localhost:5672

# --- web-bff (la única puerta que usa el frontend) ---
BFF_PORT=3000
AUTH_SERVICE_URL=http://localhost:3001
RESERVATIONS_SERVICE_URL=http://localhost:3003
PAYMENTS_SERVICE_URL=http://localhost:3004
NOTIFICATIONS_SERVICE_URL=http://localhost:3005
# (usa también RESTAURANTS_SERVICE_URL, definida arriba)
# Orígenes que pueden llamar al BFF desde el navegador, separados por coma (el frontend de Vite usa 5173)
CORS_ORIGIN=http://localhost:5173
# Cuánto espera el BFF a cada servicio antes de dar por fallida la llamada
UPSTREAM_TIMEOUT_MS=3000

# --- logs y trazabilidad (Fase 5) ---
# Los servicios escriben logs en JSON. LOG_LEVEL: debug | info | warn | error. LOG_FORMAT=pretty los muestra legibles en la terminal.
LOG_LEVEL=info
# LOG_FORMAT=pretty
# Si corrés los servicios con `npm run dev:*` y querés verlos en Grafana, descomentá esto
# (cada servicio escribe además su archivo en ./logs; Alloy lo lee):
# LOG_DIR=../../logs
GRAFANA_PORT=3030
LOKI_PORT=3100

# --- caché (Fase 8) ---
# Redis para restaurants-service. En docker compose ya viene configurado (no hace falta tocar nada).
# - Para medir "SIN caché" con docker compose: RESTAURANTS_REDIS_URL=   (vacía; sin esa línea el caché está prendido)
# - Para correr el servicio a mano (npm run dev:restaurants) CON caché, contra el Redis de compose:
# REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
CACHE_TTL_SECONDS=60

# --- compartido por todos los servicios ---
# Todos validan los JWT con este mismo secreto (lo firma auth-service).
# Generá uno propio, por ejemplo: openssl rand -hex 32
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h
# Deja que cualquiera se registre como RESTAURANT_OWNER (lo usan el Swagger y el e2e).
# Sin esta variable el servicio responde 403. En producción NO la actives.
ALLOW_OWNER_SELF_REGISTER=true
