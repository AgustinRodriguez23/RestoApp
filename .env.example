# Copiá este archivo como .env y ajustá los valores
# (docker compose lo lee automáticamente)

# --- auth-service ---
AUTH_PORT=3001
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5433
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth_password
AUTH_DB_NAME=auth_db

# --- restaurants-service ---
RESTAURANTS_PORT=3002
RESTAURANTS_MONGO_HOST=localhost
RESTAURANTS_MONGO_PORT=27018
RESTAURANTS_MONGO_USER=restaurants
RESTAURANTS_MONGO_PASSWORD=restaurants_password
RESTAURANTS_MONGO_DB=restaurants_db

# --- reservations-service ---
RESERVATIONS_PORT=3003
RESERVATIONS_DB_HOST=localhost
RESERVATIONS_DB_PORT=5434
RESERVATIONS_DB_USER=reservations
RESERVATIONS_DB_PASSWORD=reservations_password
RESERVATIONS_DB_NAME=reservations_db
# A qué dirección llama para consultar mesas y horarios (en Docker se pisa con el nombre del contenedor)
RESTAURANTS_SERVICE_URL=http://localhost:3002
# Los horarios de los restaurantes ("20:00") se interpretan en esta zona horaria
RESTAURANT_TIME_ZONE=America/Argentina/Buenos_Aires
# Duración de cada reserva, en minutos
RESERVATION_DURATION_MINUTES=90

# --- web-bff (la única puerta que usa el frontend) ---
BFF_PORT=3000
AUTH_SERVICE_URL=http://localhost:3001
RESERVATIONS_SERVICE_URL=http://localhost:3003
# (usa también RESTAURANTS_SERVICE_URL, definida arriba)
# Orígenes que pueden llamar al BFF desde el navegador, separados por coma (el frontend de Vite usa 5173)
CORS_ORIGIN=http://localhost:5173
# Cuánto espera el BFF a cada servicio antes de dar por fallida la llamada
UPSTREAM_TIMEOUT_MS=3000

# --- compartido por todos los servicios ---
# Todos validan los JWT con este mismo secreto (lo firma auth-service).
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h
