{
  "name": "reservas-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de reservas de restaurantes basada en microservicios",
  "workspaces": [
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "dev:auth": "npm run start:dev -w auth-service",
    "dev:restaurants": "npm run start:dev -w restaurants-service",
    "dev:reservations": "npm run start:dev -w reservations-service",
    "dev:payments": "npm run start:dev -w payments-service",
    "dev:notifications": "npm run start:dev -w notifications-service",
    "dev:bff": "npm run start:dev -w web-bff",
    "dev:web": "npm run dev -w web",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "infra:up": "docker compose up -d postgres-auth mongo-restaurants mongo-notifications postgres-reservations postgres-payments rabbitmq",
    "obs:up": "docker compose up -d loki alloy grafana",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "test:e2e": "node e2e/saga.e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "js-yaml": "^5.5.0"
  }
}
