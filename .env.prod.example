# Variables de producción. En el servidor: cp .env.prod.example .env  (.env no se sube a git)
# Lo que está vacío es obligatorio: docker compose no arranca hasta que lo definas, y el error dice qué variable falta.

# --- Dominio ---
# Tiene que apuntar a la IP del servidor (registro DNS A) antes de arrancar: Let's Encrypt lo valida para dar el certificado
DOMAIN=
# Para la cuenta de Let's Encrypt
ACME_EMAIL=

# --- Secretos ---
# Generá uno distinto para cada una: openssl rand -hex 32
# (hexadecimal a propósito: las contraseñas de Mongo y RabbitMQ van dentro de una URL y otros caracteres habría que codificarlos)
JWT_SECRET=
GATEWAY_WEBHOOK_SECRET=
AUTH_DB_PASSWORD=
RESERVATIONS_DB_PASSWORD=
PAYMENTS_DB_PASSWORD=
RESTAURANTS_MONGO_PASSWORD=
NOTIFICATIONS_MONGO_PASSWORD=
RABBITMQ_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- Pasarela ---
# Hasta que exista Mercado Pago: la simulada aprueba cualquier token de prueba, los pagos son de mentira.
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_GATEWAY=true

# --- Registro de dueños ---
# Con false, nadie puede registrarse como dueño de un restaurante desde afuera. Para cargar el primero, ponelo en true,
# registrate y volvé a false (docker compose -f docker-compose.prod.yml up -d auth-service aplica el cambio).
ALLOW_OWNER_SELF_REGISTER=false

# --- Versión ---
# latest es lo último de main. Para volver atrás, la etiqueta de un commit anterior: IMAGE_TAG=sha-abc1234
IMAGE_TAG=latest
