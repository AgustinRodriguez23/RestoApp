# Termina el TLS: con un dominio público, Caddy pide y renueva solo el certificado de Let's Encrypt, y redirige http a https.
# {$VARIABLE} se lee del entorno del contenedor (ver docker-compose.prod.yml).
{
	email {$ACME_EMAIL}
	# Sin HTTP/3: con él activo, Chrome cortaba la descarga del bundle de JS a la mitad (ERR_QUIC_PROTOCOL_ERROR) y la
	# página quedaba en blanco, mientras que por HTTP/1.1 y HTTP/2 el mismo archivo llegaba entero. Para un sitio de
	# este tamaño HTTP/2 rinde igual. Sin h3, Caddy tampoco anuncia Alt-Svc y los navegadores dejan de intentarlo.
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	header {
		# HSTS: el navegador recuerda por un año que este dominio va solo por https. Sin includeSubDomains para no
		# obligar a otros subdominios, que quizás no tengan https.
		Strict-Transport-Security "max-age=31536000"
		-Server
		-Via
	}

	# Caddy agrega X-Forwarded-For con la IP real del cliente (descarta el que venga de afuera) y X-Forwarded-Proto
	reverse_proxy web:80
}
